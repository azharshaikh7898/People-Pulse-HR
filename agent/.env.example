# Copy to .env (git-ignored) and fill in.
# Free Gemini key (no credit card): https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini

# The PeoplePulse API the agent talks to, and the account it acts as.
# Use an HR admin account for full access, or an employee account to see the permission limits.
HR_API_URL=http://localhost:8000
HR_API_EMAIL=hr.admin@example.com
HR_API_PASSWORD=HrAdmin#2026

# Optional tracing (https://langfuse.com, free cloud tier)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
