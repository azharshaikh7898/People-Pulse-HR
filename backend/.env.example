# Copy to .env and edit. NEVER commit the real .env file.
# SQLAlchemy URL for PostgreSQL
DATABASE_URL=postgresql://peoplepulse:CHANGE_ME@localhost:5432/peoplepulse
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_string
# development | production  (production enforces a strong SECRET_KEY and blocks the seed script)
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
# Only used by `pytest`. Must end with "_test": tests wipe this database.
TEST_DATABASE_URL=postgresql://peoplepulse:CHANGE_ME@localhost:5432/peoplepulse_test
